{
  "name": "fortress-command-center",
  "version": "1.0.0",
  "description": "FORTRESS Command Center — interfaz única para gestionar múltiples proyectos con agentes de IA",
  "main": "./out/main/index.js",
  "author": "raisenomega",
  "homepage": "https://github.com/raisenomega/fortress",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "smoke": "npm run build && electron --no-sandbox scripts/render-smoke.cjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "npm run test:unit && npm run build && electron --no-sandbox scripts/integration-test.cjs && electron --no-sandbox scripts/migration-test.cjs",
    "preview": "npm run build && electron --no-sandbox scripts/ui-preview.cjs",
    "test:unit": "vitest run",
    "install:desktop": "./install.sh",
    "icons": "electron --no-sandbox scripts/make-icons.cjs",
    "verify:scan": "npm run build && electron --no-sandbox scripts/scan-verification.cjs",
    "verify:cabecera": "node --import ./scripts/lib/cargar-ts.mjs scripts/verify-cabecera-cto.ts",
    "verify:grafo-aislamiento": "node --import ./scripts/lib/cargar-ts.mjs scripts/verify-grafo-aislamiento.ts",
    "backfill:proposal-events": "node scripts/backfill-events-i1.5.ts",
    "fase-b:clasificar": "node --import ./scripts/lib/cargar-ts.mjs scripts/fase-b-clasificar.ts",
    "fase-b:ejecutar": "node --import ./scripts/lib/cargar-ts.mjs scripts/fase-b-ejecutar.ts",
    "fase-b:plan": "node --import ./scripts/lib/cargar-ts.mjs scripts/fusion-plan.ts",
    "fase-b:juzgar": "node --import ./scripts/lib/cargar-ts.mjs scripts/fase-b-paso-b-juzgar.ts",
    "fase-b:replan": "node --import ./scripts/lib/cargar-ts.mjs scripts/fase-b-paso-b-replan.ts",
    "fase-b:aplicar": "node --import ./scripts/lib/cargar-ts.mjs scripts/fase-b-paso-b-aplicar.ts",
    "retipar:juzgar": "node --import ./scripts/lib/cargar-ts.mjs scripts/retipar-juzgar.ts",
    "retipar:aplicar": "node --import ./scripts/lib/cargar-ts.mjs scripts/retipar-aplicar.ts",
    "medir:deriva": "node --import ./scripts/lib/cargar-ts.mjs scripts/medir-deriva.ts",
    "lote:juzgar": "node --import ./scripts/lib/cargar-ts.mjs scripts/lote-alias-juzgar.ts",
    "lote:aplicar": "node --import ./scripts/lib/cargar-ts.mjs scripts/lote-alias-aplicar.ts",
    "severidad:plan": "node --import ./scripts/lib/cargar-ts.mjs scripts/severidad-plan.ts",
    "severidad:aplicar": "node --import ./scripts/lib/cargar-ts.mjs scripts/severidad-aplicar.ts"
  },
  "overrides": {
    "nanoid": "^3.3.17",
    "@xmldom/xmldom": "^0.8.15",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "fast-uri": "^3.1.8",
    "http-cache-semantics": "^4.3.0",
    "js-yaml": "^4.3.2",
    "node-gyp": {
      "undici": "^6.29.0"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "lucide-react": "^1.28.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.14"
  },
  "desktopName": "fortress.desktop"
}
